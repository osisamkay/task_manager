{
  "name": "invoicecanada",
  "version": "1.0.0",
  "description": "Professional Invoice Generator with Canadian Tax Support",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "keywords": [
    "invoice",
    "canada",
    "tax",
    "GST",
    "HST",
    "PST",
    "QST"
  ],
  "author": "OLUKAYODE",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
